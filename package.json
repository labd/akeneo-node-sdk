{
    "name": "@labdigital/akeneo-node-sdk",
    "version": "1.0.13",
    "description": "OpenAPI client for @labdigital/akeneo-node-sdk",
    "author": "OpenAPI-Generator",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/labd/akeneo-node-sdk.git"
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "main": "./dist/index.js",
    "typings": "./dist/index.d.ts",
    "module": "./dist/esm/index.js",
    "sideEffects": false,
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "build": "tsc && tsc -p tsconfig.esm.json",
        "check": "biome check && tsc --noEmit",
        "format": "biome check --write",
        "lint": "biome check",
        "typecheck": "tsc --noEmit",
        "prepare": "pnpm run build",
        "publish:ci": "pnpm build && pnpm changeset publish",
        "publish:version": "pnpm changeset version && pnpm format"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.15",
        "@changesets/changelog-github": "^1.0.1",
        "@changesets/cli": "^3.0.3",
        "typescript": "^7.0.2"
    },
    "packageManager": "pnpm@12.12.0+sha512.2ee06ac86db554cf384421461220f0e336a487bfd41b2acd04e17a86b1487832fe45e8d1743f7fc52acc77de12d2356b536fedf8229fc483239e40b13d474449"
}
